// NAV
const PAGE_TITLES={dashboard:'Dashboard',contacts:'All Contacts',pipeline:'Pipeline',outreach:'Outreach',activity:'Activity Log'};
function crmNav(page){
  document.querySelectorAll('.crm-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.crm-nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById('panel-'+page).classList.add('active');
  const nb=document.getElementById('nav-'+page);
  if(nb)nb.classList.add('active');
  document.getElementById('crm-page-title').textContent=PAGE_TITLES[page]||page;
}

// LOAD
async function loadAll(){
  await Promise.all([loadContacts(),loadLogs()]);
}

async function loadContacts(){
  const{data,error}=await sb.from('iteraai_registrations').select('*').order('created_at',{ascending:false});
  if(error){console.warn(error);return;}
  _allContacts=data||[];
  if(_allContacts.length){
    const ids=_allContacts.map(c=>c.id);
    const{data:meta}=await sb.from('iteraai_crm_meta').select('*').in('contact_id',ids);
    _contactMeta={};
    (meta||[]).forEach(m=>{_contactMeta[m.contact_id]=m;});
  }
  renderDashStats();
  renderDashContacts();
  renderContactsTable(_allContacts);
  renderPipeline();
}

async function loadLogs(){
  const{data}=await sb.from('iteraai_logs').select('*').order('ts',{ascending:false}).limit(100);
  const logs=data||[];
  const gens=logs.filter(l=>l.event&&l.event.includes('generation')).length;
  const tokens=logs.reduce((s,l)=>s+(l.input_tokens||0)+(l.output_tokens||0),0);
  document.getElementById('d-gens').textContent=gens;
  document.getElementById('d-tokens').textContent=tokens>999?(tokens/1000).toFixed(1)+'k':tokens;
  renderDashActivity(logs);
  renderActivityFull(logs);
}

// DASHBOARD
function renderDashStats(){
  const total=_allContacts.length;
  const leads=_allContacts.filter(c=>getStatus(c.id)==='lead').length;
  const pilots=_allContacts.filter(c=>getStatus(c.id)==='pilot').length;
  const actives=_allContacts.filter(c=>getStatus(c.id)==='active').length;
  document.getElementById('d-total').textContent=total;
  document.getElementById('d-leads').textContent=leads;
  document.getElementById('d-pilots').textContent=pilots;
  document.getElementById('d-active').textContent=actives;
}
function renderDashContacts(){
  document.getElementById('dash-recent-body').innerHTML=_allContacts.slice(0,8).map(c=>`
    <tr onclick="openDrawer('${c.id}')">
      <td><strong>${c.first_name} ${c.last_name}</strong></td>
      <td>${c.organization||'—'}</td>
      <td>${fmtDate(c.created_at)}</td>
      <td>${statusBadge(getStatus(c.id))}</td>
    </tr>`).join('');
}
function renderDashActivity(logs){
  document.getElementById('dash-activity-body').innerHTML=logs.slice(0,10).map(l=>`
    <tr>
      <td>${fmtDateTime(l.ts)}</td>
      <td><span class="badge ${eventBadge(l.event)}">${l.event||'—'}</span></td>
      <td>${((l.input_tokens||0)+(l.output_tokens||0)).toLocaleString()}</td>
      <td style="color:${l.status>=400?'var(--red)':'var(--green)'}">${l.status||'—'}</td>
    </tr>`).join('');
}

// CONTACTS TABLE
function renderContactsTable(contacts){
  const tbody=document.getElementById('contacts-body');
  if(!contacts.length){tbody.innerHTML='<tr><td colspan="7" style="text-align:center;padding:32px;color:var(--muted)">No contacts yet</td></tr>';return;}
  tbody.innerHTML=contacts.map(c=>{
    const meta=_contactMeta[c.id]||{};
    const tags=(meta.tags||[]).map(t=>`<span class="tag" style="font-size:10px;padding:2px 7px">${t}</span>`).join('');
    return`<tr onclick="openDrawer('${c.id}')">
      <td><strong>${c.first_name} ${c.last_name}</strong></td>
      <td style="font-size:12px;color:var(--muted)">${c.email}</td>
      <td>${c.organization||'—'}</td>
      <td>${c.role||'—'}</td>
      <td>${statusBadge(meta.crm_status||'lead')}</td>
      <td>${fmtDate(c.created_at)}</td>
      <td>${tags||'—'}</td>
    </tr>`;
  }).join('');
}
function contactsFilter(){
  const q=document.getElementById('contacts-search').value.toLowerCase();
  const st=document.getElementById('contacts-status-filter').value;
  const filtered=_allContacts.filter(c=>{
    const meta=_contactMeta[c.id]||{};
    const matchQ=!q||[c.first_name,c.last_name,c.email,c.organization||''].join(' ').toLowerCase().includes(q);
    const matchS=!st||(meta.crm_status||'lead')===st;
    return matchQ&&matchS;
  });
  renderContactsTable(filtered);
}

// PIPELINE
function renderPipeline(){
  const cols={lead:[],pilot:[],active:[],churned:[]};
  _allContacts.forEach(c=>{
    const s=getStatus(c.id);
    if(cols[s])cols[s].push(c); else cols.lead.push(c);
  });
  ['lead','pilot','active','churned'].forEach(col=>{
    document.getElementById('k-count-'+col).textContent=cols[col].length;
    document.getElementById('k-'+col).innerHTML=cols[col].map(c=>`
      <div class="kanban-card" onclick="openDrawer('${c.id}')">
        <div class="kanban-card-name">${c.first_name} ${c.last_name}</div>
        <div class="kanban-card-org">${c.organization||c.email}</div>
        <div class="kanban-card-date">${fmtDate(c.created_at)}</div>
      </div>`).join('')||'<div style="color:var(--muted);font-size:12px;text-align:center;padding:20px">Empty</div>';
  });
}

// ACTIVITY
function renderActivityFull(logs){
  document.getElementById('activity-body').innerHTML=logs.map(l=>`
    <tr>
      <td>${fmtDateTime(l.ts)}</td>
      <td><span class="badge ${eventBadge(l.event)}">${l.event||'—'}</span></td>
      <td style="font-size:12px;color:var(--muted)">${l.model||'—'}</td>
      <td>${(l.input_tokens||0).toLocaleString()}</td>
      <td>${(l.output_tokens||0).toLocaleString()}</td>
      <td style="color:${l.status>=400?'var(--red)':'var(--green)'}">${l.status||'—'}</td>
    </tr>`).join('');
}

// DRAWER
function openDrawer(id){
  const c=_allContacts.find(x=>x.id===id);
  if(!c)return;
  _currentContact=c;
  const meta=_contactMeta[id]||{};
  document.getElementById('d-avatar').textContent=((c.first_name[0]||'')+(c.last_name[0]||'')).toUpperCase();
  document.getElementById('d-name').textContent=c.first_name+' '+c.last_name;
  document.getElementById('d-meta').textContent=c.email+(c.organization?' · '+c.organization:'');
  document.getElementById('d-email').textContent=c.email;
  document.getElementById('d-org').textContent=c.organization||'—';
  document.getElementById('d-role').textContent=c.role||'—';
  document.getElementById('d-signed').textContent=fmtDate(c.created_at);
  document.getElementById('d-source').textContent=c.source||'iteraai-landing';
  document.getElementById('d-status-sel').value=meta.crm_status||'lead';
  renderDrawerTags(meta.tags||[]);
  renderDrawerNotes(meta.notes||[]);
  document.getElementById('d-email-subject').value='';
  document.getElementById('d-email-body').value='';
  document.getElementById('contact-drawer').classList.add('open');
  document.getElementById('drawer-backdrop').classList.add('open');
}
function closeDrawer(){
  document.getElementById('contact-drawer').classList.remove('open');
  document.getElementById('drawer-backdrop').classList.remove('open');
  _currentContact=null;
}
function renderDrawerTags(tags){
  document.getElementById('d-tags-wrap').innerHTML=tags.map((t,i)=>
    `<span class="tag">${t}<button class="tag-remove" onclick="removeTag(${i})">x</button></span>`).join('');
}
function renderDrawerNotes(notes){
  const list=document.getElementById('d-notes-list');
  if(!notes.length){list.innerHTML='<div style="color:var(--muted);font-size:13px">No notes yet</div>';return;}
  list.innerHTML=[...notes].reverse().map(n=>`
    <div class="note-item">${n.text}<div class="note-ts">${fmtDateTime(n.ts)}</div></div>`).join('');
}

// CONTACT META
async function saveContactStatus(){
  if(!_currentContact)return;
  await upsertMeta(_currentContact.id,{crm_status:document.getElementById('d-status-sel').value});
  toast('Status updated');renderPipeline();renderDashContacts();renderDashStats();
}
async function addTag(){
  if(!_currentContact)return;
  const input=document.getElementById('d-tag-input');
  const tag=input.value.trim().replace(',','');
  if(!tag)return;
  const meta=_contactMeta[_currentContact.id]||{};
  const tags=[...(meta.tags||[])];
  if(!tags.includes(tag))tags.push(tag);
  await upsertMeta(_currentContact.id,{tags});
  renderDrawerTags(tags);input.value='';toast('Tag added');
}
async function removeTag(idx){
  if(!_currentContact)return;
  const meta=_contactMeta[_currentContact.id]||{};
  const tags=[...(meta.tags||[])];
  tags.splice(idx,1);
  await upsertMeta(_currentContact.id,{tags});
  renderDrawerTags(tags);toast('Tag removed');
}
async function addNote(){
  if(!_currentContact)return;
  const text=document.getElementById('d-note-input').value.trim();
  if(!text)return;
  const meta=_contactMeta[_currentContact.id]||{};
  const notes=[...(meta.notes||[]),{text,ts:new Date().toISOString()}];
  await upsertMeta(_currentContact.id,{notes});
  renderDrawerNotes(notes);document.getElementById('d-note-input').value='';toast('Note saved');
}
async function upsertMeta(contactId,patch){
  const existing=_contactMeta[contactId]||{contact_id:contactId};
  const updated={...existing,...patch,contact_id:contactId};
  _contactMeta[contactId]=updated;
  await sb.from('iteraai_crm_meta').upsert([updated],{onConflict:'contact_id'});
  renderContactsTable(_allContacts);
}
function getStatus(id){return(_contactMeta[id]||{}).crm_status||'lead';}

// QUICK EMAIL
async function sendQuickEmail(){
  if(!_currentContact)return;
  const subject=document.getElementById('d-email-subject').value.trim();
  const body=document.getElementById('d-email-body').value.trim();
  if(!subject||!body){toast('Subject and message required');return;}
  try{
    await emailjs.send(EMAILJS_SVC,EMAILJS_TPL,{
      to_email:_currentContact.email,name:_currentContact.first_name,
      subject,message:body,reply_to:'jmj.juliano@gmail.com'
    });
    toast('Email sent to '+_currentContact.email);
    document.getElementById('d-email-subject').value='';
    document.getElementById('d-email-body').value='';
  }catch(e){toast('Email failed: '+(e.text||e.message||'unknown error'));}
}

// OUTREACH
function outToggleSingle(){
  document.getElementById('out-single-wrap').style.display=
    document.getElementById('out-segment').value==='single'?'block':'none';
}
function outUpdatePreview(){
  const seg=document.getElementById('out-segment').value;
  const subject=document.getElementById('out-subject').value||'(no subject)';
  const body=document.getElementById('out-message').value||'(no message)';
  const single=document.getElementById('out-single-email').value;
  let toLabel='';
  if(seg==='single') toLabel=single||'single email';
  else if(seg==='all') toLabel='All contacts ('+_allContacts.length+')';
  else{const count=_allContacts.filter(c=>getStatus(c.id)===seg).length;toLabel=seg+' ('+count+')';}
  document.getElementById('out-preview-to').textContent=toLabel;
  document.getElementById('out-preview-subject').textContent=subject;
  document.getElementById('out-preview-body').textContent=body;
}
async function outSend(){
  const seg=document.getElementById('out-segment').value;
  const subject=document.getElementById('out-subject').value.trim();
  const body=document.getElementById('out-message').value.trim();
  const reply=document.getElementById('out-reply').value.trim();
  const single=document.getElementById('out-single-email').value.trim();
  if(!subject||!body){toast('Subject and message required');return;}
  let recipients=[];
  if(seg==='single'){if(!single){toast('Enter a recipient email');return;}recipients=[{email:single,first_name:''}];}
  else if(seg==='all') recipients=_allContacts;
  else recipients=_allContacts.filter(c=>getStatus(c.id)===seg);
  if(!recipients.length){toast('No contacts in this segment');return;}
  const btn=document.getElementById('out-send-btn');
  btn.textContent='Sending...';btn.disabled=true;
  const statusEl=document.getElementById('out-status');
  let sent=0,failed=0;
  for(const r of recipients){
    try{
      await emailjs.send(EMAILJS_SVC,EMAILJS_TPL,{
        to_email:r.email,name:r.first_name||'',subject,message:body,reply_to:reply
      });
      sent++;
    }catch(e){failed++;}
    statusEl.textContent='Sent: '+sent+' / Failed: '+failed+' of '+recipients.length;
    await new Promise(r=>setTimeout(r,350));
  }
  btn.textContent='Send Email';btn.disabled=false;
  toast('Done — '+sent+' sent, '+failed+' failed');
}

// EXPORT
function exportCSV(){
  const rows=[['First Name','Last Name','Email','Organization','Role','Status','Signed Up','Tags']];
  _allContacts.forEach(c=>{
    const meta=_contactMeta[c.id]||{};
    rows.push([c.first_name,c.last_name,c.email,c.organization||'',c.role||'',
      meta.crm_status||'lead',fmtDate(c.created_at),(meta.tags||[]).join('; ')]);
  });
  const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n');
  const blob=new Blob([csv],{type:'text/csv'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');a.href=url;a.download='iteraai-contacts.csv';a.click();
  URL.revokeObjectURL(url);toast('CSV exported');
}

// HELPERS
function fmtDate(ts){if(!ts)return'—';return new Date(ts).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});}
function fmtDateTime(ts){if(!ts)return'—';return new Date(ts).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});}
function statusBadge(s){const m={lead:'badge-lead',pilot:'badge-pilot',active:'badge-active',churned:'badge-churned'};return'<span class="badge '+(m[s]||'badge-none')+'">'+(s||'lead')+'</span>';}
function eventBadge(e){if(!e)return'badge-none';if(e.includes('stream'))return'badge-stream';if(e.includes('generation'))return'badge-gen';return'badge-none';}
function toast(msg,ms=3000){const el=document.getElementById('crm-toast');el.textContent=msg;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),ms);}
</script>
