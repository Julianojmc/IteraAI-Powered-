<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IteraAI CRM</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#1a1630;--ink2:#3d3760;--muted:#7a75a0;--border:#e4e1f5;
  --bg:#f5f3fd;--white:#ffffff;--purple:#7c5cbf;--purple-d:#5a3fa0;
  --purple-l:#ede8fa;--teal:#00C9A7;--teal-d:#00a88c;--teal-l:#e0faf5;
  --gold:#f0a500;--gold-l:#fff8e1;--red:#e05252;--red-l:#fdeaea;
  --green:#2ecc87;--green-l:#e6faf3;--orange:#f07050;--orange-l:#fff0ec;
  --shadow:0 2px 16px rgba(100,80,180,.10);--shadow-lg:0 8px 40px rgba(100,80,180,.16);
  --radius:14px;--sidebar-w:220px;--font:'Outfit',sans-serif;--mono:'DM Mono',monospace;
}
html,body{height:100%;font-family:var(--font);background:var(--bg);color:var(--ink)}

/* LOGIN */
#crm-login{position:fixed;inset:0;background:linear-gradient(135deg,#1a1630 0%,#2d1f6e 50%,#4a3a9a 100%);display:flex;align-items:center;justify-content:center;z-index:9999}
.login-box{background:rgba(255,255,255,.06);border:1.5px solid rgba(255,255,255,.15);border-radius:24px;padding:48px 44px;width:100%;max-width:400px;backdrop-filter:blur(20px);text-align:center}
.login-logo{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#00C9A7;margin-bottom:8px}
.login-title{font-size:28px;font-weight:800;color:white;letter-spacing:-.03em;margin-bottom:6px}
.login-sub{font-size:14px;color:rgba(255,255,255,.55);margin-bottom:32px}
.login-input{width:100%;padding:13px 16px;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.15);border-radius:12px;color:white;font-size:15px;font-family:var(--font);outline:none;margin-bottom:12px;transition:border-color .2s}
.login-input::placeholder{color:rgba(255,255,255,.35)}
.login-input:focus{border-color:#00C9A7}
.login-btn{width:100%;padding:13px;background:#00C9A7;color:#0d2e28;border:none;border-radius:12px;font-size:15px;font-weight:700;font-family:var(--font);cursor:pointer}
.login-btn:hover{background:#00a88c}
.login-err{color:#ff8080;font-size:13px;margin-top:10px;display:none}

/* APP */
#crm-app{display:none;height:100vh;overflow:hidden}

/* SIDEBAR */
.crm-sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:var(--ink);display:flex;flex-direction:column;z-index:100}
.crm-sidebar-logo{padding:22px 20px 18px;border-bottom:1px solid rgba(255,255,255,.08)}
.wordmark{font-size:17px;font-weight:800;color:white;letter-spacing:-.02em}
.wordmark span{color:#00C9A7}
.crm-badge-sub{display:inline-block;margin-top:4px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.4)}
.crm-nav{flex:1;padding:12px 10px;overflow-y:auto}
.crm-nav-section{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.3);padding:14px 10px 6px}
.crm-nav-btn{display:flex;align-items:center;gap:10px;width:100%;padding:9px 12px;background:none;border:none;border-radius:10px;color:rgba(255,255,255,.6);font-size:13.5px;font-weight:500;font-family:var(--font);cursor:pointer;text-align:left;transition:all .15s;margin-bottom:2px}
.crm-nav-btn:hover{background:rgba(255,255,255,.07);color:white}
.crm-nav-btn.active{background:var(--purple);color:white}
.crm-sidebar-footer{padding:14px 16px;border-top:1px solid rgba(255,255,255,.08);font-size:11.5px;color:rgba(255,255,255,.3)}

/* MAIN */
.crm-main{margin-left:var(--sidebar-w);height:100vh;overflow-y:auto;display:flex;flex-direction:column}
.crm-topbar{position:sticky;top:0;background:rgba(245,243,253,.95);backdrop-filter:blur(12px);border-bottom:1.5px solid var(--border);padding:14px 28px;display:flex;align-items:center;justify-content:space-between;z-index:50}
.crm-topbar-title{font-size:18px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
.crm-topbar-actions{display:flex;gap:10px;align-items:center}
.crm-content{padding:28px;flex:1}

/* PANELS */
.crm-panel{display:none}
.crm-panel.active{display:block}

/* STAT CARDS */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:24px}
.stat-card{background:var(--white);border-radius:var(--radius);padding:20px;border:1.5px solid var(--border);box-shadow:var(--shadow)}
.stat-val{font-size:34px;font-weight:900;letter-spacing:-.04em;color:var(--purple);line-height:1}
.stat-lbl{font-size:12px;color:var(--muted);margin-top:5px;font-weight:500}

/* CARDS */
.crm-card{background:var(--white);border-radius:var(--radius);border:1.5px solid var(--border);box-shadow:var(--shadow);overflow:hidden;margin-bottom:18px}
.crm-card-hdr{padding:16px 20px;border-bottom:1.5px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.crm-card-title{font-size:14px;font-weight:700;color:var(--ink)}
.crm-card-body{padding:20px}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:9px;font-size:13px;font-weight:600;font-family:var(--font);cursor:pointer;border:none;transition:all .15s;white-space:nowrap}
.btn-primary{background:var(--purple);color:white}
.btn-primary:hover{background:var(--purple-d);transform:translateY(-1px)}
.btn-teal{background:var(--teal);color:#0d2e28}
.btn-teal:hover{background:var(--teal-d)}
.btn-ghost{background:var(--purple-l);color:var(--purple-d)}
.btn-ghost:hover{background:var(--border)}
.btn-danger{background:var(--red-l);color:var(--red)}
.btn-sm{padding:5px 11px;font-size:12px;border-radius:7px}

/* TABLE */
.crm-table{width:100%;border-collapse:collapse;font-size:13px}
.crm-table th{text-align:left;padding:10px 14px;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);border-bottom:1.5px solid var(--border);background:var(--bg)}
.crm-table td{padding:11px 14px;border-bottom:1px solid var(--border);color:var(--ink);vertical-align:middle}
.crm-table tr:last-child td{border-bottom:none}
.crm-table tr:hover td{background:var(--bg);cursor:pointer}

/* FILTERS */
.crm-filters{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap;align-items:center}
.crm-search{flex:1;min-width:200px;padding:9px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:13.5px;font-family:var(--font);background:var(--white);color:var(--ink);outline:none}
.crm-search:focus{border-color:var(--purple)}
.crm-select{padding:9px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:13px;font-family:var(--font);background:var(--white);color:var(--ink);outline:none;cursor:pointer}

/* BADGES */
.badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700}
.badge-lead{background:var(--gold-l);color:#a07000}
.badge-pilot{background:var(--purple-l);color:var(--purple-d)}
.badge-active{background:var(--green-l);color:#1a8a5a}
.badge-churned{background:var(--red-l);color:var(--red)}
.badge-none{background:var(--bg);color:var(--muted)}
.badge-gen{background:var(--green-l);color:#1a8a5a}
.badge-stream{background:var(--purple-l);color:var(--purple-d)}

/* DRAWER */
#contact-drawer{position:fixed;top:0;right:-520px;bottom:0;width:500px;background:var(--white);border-left:1.5px solid var(--border);box-shadow:-8px 0 40px rgba(0,0,0,.12);z-index:200;transition:right .3s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;overflow:hidden}
#contact-drawer.open{right:0}
.drawer-hdr{padding:20px 22px 16px;border-bottom:1.5px solid var(--border);display:flex;align-items:flex-start;justify-content:space-between}
.drawer-body{flex:1;overflow-y:auto;padding:20px 22px}
.drawer-close{background:var(--bg);border:none;border-radius:8px;width:30px;height:30px;font-size:18px;cursor:pointer;color:var(--muted);display:flex;align-items:center;justify-content:center}
.drawer-avatar{width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,var(--purple),var(--purple-d));display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;color:white;margin-bottom:10px}
.drawer-name{font-size:20px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
.drawer-meta{font-size:13px;color:var(--muted);margin-top:2px}
.drawer-section{margin-bottom:20px}
.drawer-section-title{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--border)}
.drawer-field{display:flex;gap:8px;margin-bottom:8px;font-size:13px}
.drawer-field-lbl{color:var(--muted);min-width:90px;flex-shrink:0}
.drawer-field-val{color:var(--ink);font-weight:500}

/* NOTES */
.note-item{background:var(--bg);border-radius:10px;padding:12px 14px;margin-bottom:10px;font-size:13px;color:var(--ink);border-left:3px solid var(--purple)}
.note-ts{font-size:11px;color:var(--muted);margin-top:6px}
.note-input{width:100%;padding:10px 12px;border:1.5px solid var(--border);border-radius:10px;font-size:13px;font-family:var(--font);resize:vertical;min-height:72px;outline:none;color:var(--ink)}
.note-input:focus{border-color:var(--purple)}

/* TAGS */
.tag{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;background:var(--purple-l);color:var(--purple-d);font-size:11.5px;font-weight:600;margin:2px}
.tag-remove{cursor:pointer;font-size:13px;opacity:.6;background:none;border:none;color:inherit;padding:0}
.tag-remove:hover{opacity:1}
.tag-input{padding:4px 10px;border:1.5px dashed var(--border);border-radius:20px;font-size:12px;font-family:var(--font);outline:none;width:100px;color:var(--ink);background:transparent}
.tag-input:focus{border-color:var(--purple)}

/* KANBAN */
.kanban-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.kanban-col{background:var(--bg);border-radius:var(--radius);padding:14px;min-height:400px;border:1.5px solid var(--border)}
.kanban-col-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.kanban-col-title{font-size:13px;font-weight:700;color:var(--ink)}
.kanban-count{background:var(--white);border:1.5px solid var(--border);border-radius:20px;padding:2px 8px;font-size:11px;font-weight:700;color:var(--muted)}
.kanban-card{background:var(--white);border-radius:10px;padding:12px 14px;margin-bottom:10px;border:1.5px solid var(--border);cursor:pointer;box-shadow:var(--shadow);transition:all .15s}
.kanban-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.kanban-card-name{font-size:13.5px;font-weight:700;color:var(--ink)}
.kanban-card-org{font-size:12px;color:var(--muted);margin-top:2px}
.kanban-card-date{font-size:11px;color:var(--muted);margin-top:6px}

/* FORMS */
.form-label{font-size:12px;font-weight:700;color:var(--muted);margin-bottom:5px;display:block;letter-spacing:.04em;text-transform:uppercase}
.form-input,.form-select,.form-textarea{width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-size:13.5px;font-family:var(--font);color:var(--ink);outline:none;background:var(--white)}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--purple)}
.form-textarea{resize:vertical;min-height:120px}
.outreach-preview{background:var(--bg);border-radius:12px;padding:16px 18px;border:1.5px solid var(--border);font-size:13px;color:var(--ink);line-height:1.7;white-space:pre-wrap;min-height:120px}

/* BACKDROP */
.drawer-backdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.25);z-index:190}
.drawer-backdrop.open{display:block}

/* TOAST */
#crm-toast{position:fixed;bottom:24px;right:24px;background:var(--ink);color:white;padding:12px 20px;border-radius:12px;font-size:13.5px;font-weight:500;box-shadow:var(--shadow-lg);z-index:9999;transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.4,0,.2,1)}
#crm-toast.show{transform:translateY(0);opacity:1}

/* TWO COL */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="crm-login">
  <div class="login-box">
    <div class="login-logo">IteraAI</div>
    <div class="login-title">CRM Dashboard</div>
    <div class="login-sub">Restricted access · Admin only</div>
    <input class="login-input" type="password" id="login-pw" placeholder="Enter password">
    <button class="login-btn" onclick="crmAuth()">Access Dashboard</button>
    <div class="login-err" id="login-err">Incorrect password. Try again.</div>
  </div>
</div>

<!-- APP -->
<div id="crm-app">
  <aside class="crm-sidebar">
    <div class="crm-sidebar-logo">
      <div class="wordmark">Itera<span>AI</span></div>
      <div class="crm-badge-sub">CRM · Admin</div>
    </div>
    <nav class="crm-nav">
      <div class="crm-nav-section">Overview</div>
      <button class="crm-nav-btn active" onclick="crmNav('dashboard')" id="nav-dashboard">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        Dashboard
      </button>
      <div class="crm-nav-section">Contacts</div>
      <button class="crm-nav-btn" onclick="crmNav('contacts')" id="nav-contacts">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        All Contacts
      </button>
      <button class="crm-nav-btn" onclick="crmNav('pipeline')" id="nav-pipeline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M22 12H2"/><path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"/></svg>
        Pipeline
      </button>
      <div class="crm-nav-section">Engage</div>
      <button class="crm-nav-btn" onclick="crmNav('outreach')" id="nav-outreach">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        Outreach
      </button>
      <button class="crm-nav-btn" onclick="crmNav('activity')" id="nav-activity">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Activity Log
      </button>
    </nav>
    <div class="crm-sidebar-footer">IteraAI CRM v1.0</div>
  </aside>

  <main class="crm-main">
    <div class="crm-topbar">
      <div class="crm-topbar-title" id="crm-page-title">Dashboard</div>
      <div class="crm-topbar-actions">
        <button class="btn btn-ghost btn-sm" onclick="loadAll()">↻ Refresh</button>
        <button class="btn btn-danger btn-sm" onclick="crmLogout()">Logout</button>
      </div>
    </div>

    <div class="crm-content">

      <!-- DASHBOARD -->
      <div class="crm-panel active" id="panel-dashboard">
        <div class="stat-grid">
          <div class="stat-card"><div class="stat-val" id="d-total">—</div><div class="stat-lbl">Total Contacts</div></div>
          <div class="stat-card"><div class="stat-val" id="d-leads" style="color:var(--gold)">—</div><div class="stat-lbl">Leads</div></div>
          <div class="stat-card"><div class="stat-val" id="d-pilots" style="color:var(--purple)">—</div><div class="stat-lbl">Pilots</div></div>
          <div class="stat-card"><div class="stat-val" id="d-active" style="color:var(--green)">—</div><div class="stat-lbl">Active</div></div>
          <div class="stat-card"><div class="stat-val" id="d-gens" style="color:var(--teal)">—</div><div class="stat-lbl">AI Generations</div></div>
          <div class="stat-card"><div class="stat-val" id="d-tokens" style="color:var(--teal)">—</div><div class="stat-lbl">Tokens Used</div></div>
        </div>
        <div class="two-col">
          <div class="crm-card">
            <div class="crm-card-hdr">
              <div class="crm-card-title">Recent Registrations</div>
              <button class="btn btn-ghost btn-sm" onclick="crmNav('contacts')">View all</button>
            </div>
            <div class="crm-card-body" style="padding:0">
              <table class="crm-table"><thead><tr><th>Name</th><th>School</th><th>Date</th><th>Status</th></tr></thead><tbody id="dash-recent-body"></tbody></table>
            </div>
          </div>
          <div class="crm-card">
            <div class="crm-card-hdr"><div class="crm-card-title">Recent API Activity</div></div>
            <div class="crm-card-body" style="padding:0">
              <table class="crm-table"><thead><tr><th>Time</th><th>Event</th><th>Tokens</th><th>Status</th></tr></thead><tbody id="dash-activity-body"></tbody></table>
            </div>
          </div>
        </div>
      </div>

      <!-- CONTACTS -->
      <div class="crm-panel" id="panel-contacts">
        <div class="crm-filters">
          <input class="crm-search" id="contacts-search" placeholder="Search name, email, school..." oninput="contactsFilter()">
          <select class="crm-select" id="contacts-status-filter" onchange="contactsFilter()">
            <option value="">All Statuses</option>
            <option value="lead">Lead</option>
            <option value="pilot">Pilot</option>
            <option value="active">Active</option>
            <option value="churned">Churned</option>
          </select>
          <button class="btn btn-teal btn-sm" onclick="exportCSV()">Export CSV</button>
        </div>
        <div class="crm-card">
          <div class="crm-card-body" style="padding:0">
            <table class="crm-table">
              <thead><tr><th>Name</th><th>Email</th><th>School/Org</th><th>Role</th><th>Status</th><th>Signed Up</th><th>Tags</th></tr></thead>
              <tbody id="contacts-body"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PIPELINE -->
      <div class="crm-panel" id="panel-pipeline">
        <div class="kanban-grid">
          <div class="kanban-col">
            <div class="kanban-col-hdr"><span class="kanban-col-title">Lead</span><span class="kanban-count" id="k-count-lead">0</span></div>
            <div id="k-lead"></div>
          </div>
          <div class="kanban-col">
            <div class="kanban-col-hdr"><span class="kanban-col-title">Pilot</span><span class="kanban-count" id="k-count-pilot">0</span></div>
            <div id="k-pilot"></div>
          </div>
          <div class="kanban-col">
            <div class="kanban-col-hdr"><span class="kanban-col-title">Active</span><span class="kanban-count" id="k-count-active">0</span></div>
            <div id="k-active"></div>
          </div>
          <div class="kanban-col">
            <div class="kanban-col-hdr"><span class="kanban-col-title">Churned</span><span class="kanban-count" id="k-count-churned">0</span></div>
            <div id="k-churned"></div>
          </div>
        </div>
      </div>

      <!-- OUTREACH -->
      <div class="crm-panel" id="panel-outreach">
        <div class="two-col">
          <div class="crm-card">
            <div class="crm-card-hdr"><div class="crm-card-title">Compose Email</div></div>
            <div class="crm-card-body" style="display:grid;gap:14px">
              <div>
                <label class="form-label">Recipient Segment</label>
                <select class="form-select" id="out-segment" onchange="outToggleSingle();outUpdatePreview()">
                  <option value="all">All Contacts</option>
                  <option value="lead">Leads only</option>
                  <option value="pilot">Pilots only</option>
                  <option value="active">Active only</option>
                  <option value="single">Single contact</option>
                </select>
              </div>
              <div id="out-single-wrap" style="display:none">
                <label class="form-label">Recipient Email</label>
                <input class="form-input" id="out-single-email" placeholder="educator@school.edu" oninput="outUpdatePreview()">
              </div>
              <div>
                <label class="form-label">Subject</label>
                <input class="form-input" id="out-subject" placeholder="Subject line" oninput="outUpdatePreview()">
              </div>
              <div>
                <label class="form-label">Message</label>
