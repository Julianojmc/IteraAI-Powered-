const SUPA_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlnZXN1dGZ4bXppZHR1ZGJibHRiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI4OTE2OTEsImV4cCI6MjA4ODQ2NzY5MX0.GkpR1Lwz1nbbkCUVu62yo_QBFloMUMSw-BwxpUd4DsU';
const EMAILJS_PK    = '8G-ODFfDC27VFK4lj';
const EMAILJS_SVC   = 'service_2w7f3w9';
const EMAILJS_TPL   = 'template_fhqyqcs';

let sb, _allContacts=[], _contactMeta={}, _currentContact=null;

// AUTH
function crmAuth(){
  if(document.getElementById('login-pw').value===CRM_PASSWORD){
    document.getElementById('crm-login').style.display='none';
    document.getElementById('crm-app').style.display='block';
